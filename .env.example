# SupplySync Environment Configuration Template
# Copy this file to .env for local development

# Frontend Configuration (Vite client environment)
VITE_API_URL=http://localhost:5001/api

# Node.js API Gateway / Backend Server
PORT=5001
NODE_ENV=development
OPTIMIZATION_SERVICE_URL=http://localhost:8000

# Authentication & Session Security (SQLite Persistent Store)
DATABASE_PATH=data/supplysync.db
SESSION_EXPIRY_HOURS=24

# Evaluator Account Credentials (Server-side only)
# Set a secure password on the server to seed the evaluator account (evaluator@supplysync.io).
# In production, this must be >= 12 characters and not use known development defaults.
# Leaving this unset safely disables automated evaluator seeding.
DEMO_USER_PASSWORD=

# CORS & CSRF Configuration (Comma-separated trusted frontend origins)
# In development, localhost and 127.0.0.1 loopbacks are permitted for local development.
# In production, ONLY explicit origins listed below are allowed access with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Python Optimization & Forecasting Engine
ENGINE_PORT=8000
ENGINE_HOST=0.0.0.0
